{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://railway-headway.org/schemas/signalling.schema.json",
  "title": "SignallingModel",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "dataset_id",
    "system",
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "type": "string"
    },
    "system": {
      "type": "object",
      "required": [
        "technology_type",
        "aspect_model"
      ],
      "additionalProperties": false,
      "properties": {
        "technology_type": {
          "type": "string",
          "enum": [
            "GENERIC_FIXED_BLOCK_ENGINEERING_MODEL",
            "ETCS_LEVEL_2",
            "ETCS_LEVEL_2_ENGINEERING_MODEL",
            "CBTC_MOVING_BLOCK",
            "CBTC_MOVING_BLOCK_ENGINEERING_MODEL"
          ]
        },
        "aspect_model": {
          "type": "string",
          "enum": [
            "TWO_ASPECT",
            "THREE_ASPECT",
            "FOUR_ASPECT"
          ]
        },
        "default_overlap_m": {
          "type": "number",
          "minimum": 0.0,
          "default": 50.0
        },
        "sighting_time_s": {
          "type": "number",
          "minimum": 0.0,
          "default": 8.0
        },
        "route_setup_time_s": {
          "type": "number",
          "minimum": 0.0,
          "default": 3.0
        },
        "release_delay_s": {
          "type": "number",
          "minimum": 0.0,
          "default": 4.0
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signal_id",
          "link_id",
          "offset_m"
        ],
        "additionalProperties": false,
        "properties": {
          "signal_id": {
            "type": "string"
          },
          "link_id": {
            "type": "string"
          },
          "offset_m": {
            "type": "number",
            "minimum": 0.0
          },
          "direction": {
            "type": "string",
            "enum": [
              "BIDIRECTIONAL",
              "NOMINAL",
              "REVERSE"
            ],
            "default": "NOMINAL"
          },
          "signal_type": {
            "type": "string",
            "enum": [
              "MAIN",
              "DISTANT",
              "HOLDING",
              "SHUNTING"
            ],
            "default": "MAIN"
          },
          "sighting_distance_m": {
            "type": "number",
            "minimum": 0.0,
            "default": 200.0
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "block_id",
          "link_intervals"
        ],
        "additionalProperties": false,
        "properties": {
          "block_id": {
            "type": "string"
          },
          "entry_signal_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_signal_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "link_intervals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "link_id",
                "start_offset_m",
                "end_offset_m"
              ],
              "additionalProperties": false,
              "properties": {
                "link_id": {
                  "type": "string"
                },
                "start_offset_m": {
                  "type": "number",
                  "minimum": 0.0
                },
                "end_offset_m": {
                  "type": "number",
                  "minimum": 0.0
                }
              }
            }
          },
          "overlap_m": {
            "type": "number",
            "minimum": 0.0,
            "default": 50.0
          },
          "release_delay_s": {
            "type": "number",
            "minimum": 0.0,
            "default": 4.0
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "route_id",
          "entry_signal_id",
          "exit_signal_id",
          "link_sequence"
        ],
        "additionalProperties": false,
        "properties": {
          "route_id": {
            "type": "string"
          },
          "entry_signal_id": {
            "type": "string"
          },
          "exit_signal_id": {
            "type": "string"
          },
          "link_sequence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "protected_blocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflicting_route_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}